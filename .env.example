# map-service-agent — .env 템플릿
# 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.
# 단일 docker-compose 운영 시 ../map-service-infra/.env.example과 동기화 유지.
# 변수명은 AgentSettings 필드와 정확히 일치해야 .env 값이 로드된다
# (model_config: env_prefix 없음, extra="ignore" → 불일치 변수는 조용히 무시됨).

# ── (1) PostgreSQL (LangGraph 체크포인터, schema=langgraph) ─────────
# CHECKPOINT_ENABLED=true 면 lifespan 이 체크포인터를 배선하며,
# 연결 실패 시 부팅을 중단한다(fail-fast). false 면 체크포인터 없이 기동.
CHECKPOINT_ENABLED=true
POSTGRES_DB=map
POSTGRES_USER=map
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
LANGGRAPH_SCHEMA=langgraph

# ── (2) Redis Streams (agent:jobs:done / agent:jobs:status 발행) ────
# Streams 는 DB2 를 사용한다 — map-service-user 컨슈머 redis.db-streams 기본값(2)과
# 일치해야 추천 결과가 정상 수신된다.
REDIS_URL=redis://redis:6379
REDIS_DB_STREAMS=2
STREAM_NAME=agent:jobs:done
STREAM_MAXLEN=2000
STATUS_STREAM_NAME=agent:jobs:status
STATUS_STREAM_MAXLEN=2000
# rate-limit(token-bucket/일일 카운터)은 DB3 를 사용한다.
REDIS_DB_RATELIMIT=3

# ── (3) 내부 서비스 인증·라우팅 (B2 / B4 boundary) ─────────────────
# 설정 시 /v1/recommend 인바운드 요청의 X-Internal-Token 헤더를 검증하고,
# hub 아웃바운드 호출에 동일 토큰을 부착한다. 미설정 시 검증 생략(경고 로그).
INTERNAL_SERVICE_TOKEN=replace-with-32-chars-or-more
# true 면 lifespan 부팅 시 INTERNAL_SERVICE_TOKEN 이 비어 있으면 중단(fail-fast).
# false(기본)면 토큰 미설정을 허용(경고 로그와 함께 검증 생략).
AUTH_ENFORCED=false
HUB_BASE_URL=http://hub:8000
# hub HTTP 전체 timeout(초). AgentSettings 기본값(5.0)과 일치시킨다.
HUB_TIMEOUT_SECONDS=5

# ── 리뷰 보강(hub /v1/reviews) · 룰 엔진(hub /v1/rules/*) ───────────
# grounded 경로에서 상위 후보에 블로그 리뷰 스니펫을 붙여 프롬프트를 보강한다.
# best-effort(실패해도 잡을 죽이지 않음) + LLM 호출을 추가하지 않는다(hub HTTP 만).
REVIEWS_ENRICH_ENABLED=true
# 리뷰를 조회할 상위 후보 수 / 후보당 요청 리뷰 수.
REVIEWS_MAX_PLACES=3
REVIEWS_DISPLAY=5
# 잡 1건이 hub /v1/reviews 를 호출할 총 상한(안전망).
REVIEWS_FETCH_CAP_PER_JOB=10

# ── 블로그 요약 파이프라인 ─────────────────────────────────────
# 추천과 분리된 별도 파이프라인이다. 장소를 눌렀을 때, 그리고 일정이 만들어진
# 직후 미리 만들어 둘 때 이 경로가 돈다.
# false 면 요약 엔드포인트가 모델을 부르지 않고 빈 결과를 준다(kill-switch).
SUMMARY_ENABLED=true
# 한 요청에 담을 장소 수 상한(요청 스키마 상한과 같은 값, 배포 없이 낮출 수 있다).
SUMMARY_MAX_PLACES=7
# 요약 요청 1건당 LLM 호출 예산: 본 호출 1 + 형식 이탈 시 교정 재시도 1.
SUMMARY_MAX_LLM_CALLS=2
# rules_filter/score_and_rank 가 hub 룰 엔드포인트를 호출한다. false 면 두 노드가
# no-op pass-through 로 복귀(kill-switch — hub 장애/회귀 시 즉시 무력화).
RULES_ENABLED=true

# ── (4) Gemini (LLM: recommend_places / recommend_route / llm_reason) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 외부 API 한도(문서화): RPM 10 / RPD 250. 집행은 아래 두 값이 담당한다.
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250
# agent 자체 일일 상한(SoT R-01: 200/일, 50은 데모 예비). KST 자정 리셋.
GEMINI_RPD_CAP=200
# 추천 요청 1건당 LLM 호출 하드 예산(장소 선정 1 + 동선 1 + 이유 1, 교정 재시도 포함).
# 블로그 요약은 이 예산과 무관하다 — 별도 파이프라인이 자기 예산으로 돈다.
GEMINI_MAX_CALLS_PER_REQUEST=3
# 구조화 출력 결정성/신뢰성 파라미터.
GEMINI_TEMPERATURE=0.2
# Gemini 2.5 는 thinking 토큰이 max_output_tokens 를 함께 소비한다. 과소 시
# JSON 절단으로 검증 실패 → 여유 마진 8192.
GEMINI_MAX_OUTPUT_TOKENS=8192
# thinking 예산: 0=끔(구조화 추출 신뢰성 최적, 기본), 양수=허용, 음수=모델 기본.
GEMINI_THINKING_BUDGET=0

# ── 전송 재시도(503/500 완화) ─────────────────────────────────
# 무료 티어 503 "high demand" 빈발 대응. SDK 내장 지수 백오프 재시도를 켠다.
# 재시도는 요청 예산·호출 한도 회계와 무관(전송 계층).
GEMINI_RETRY_ATTEMPTS=3            # 총 시도 수(1 이하=재시도 끔)
GEMINI_RETRY_INITIAL_DELAY=1.0     # 백오프 초기 지연(초)
GEMINI_RETRY_MAX_DELAY=8.0         # 백오프 상한(초)
# 재시도 대상 코드. 429 는 절대 넣지 말 것(RateLimiter 이중 소진). 빈값=끔.
GEMINI_RETRY_STATUS_CODES=503,500
# per-attempt(시도별) HTTP 타임아웃(초). 시도 1건의 hang 을 bound.
GEMINI_HTTP_TIMEOUT_SECONDS=30

# ── (5) 잡 타이밍 ───────────────────────────────────────────────
# per-attempt(30s) × attempts(3) + 백오프(≈5s) ≈ 95s 를 담도록 호출당
# outer wait_for 를 100s 로 둔다(재시도가 wait_for 에 잘리지 않게).
GEMINI_TIMEOUT_SECONDS=100
# 잡 전체 wall-clock 캡. 이론최악(재시도 포함)은 넘을 수 있으나 본 캡이
# 300s 에서 강제 종료. BFF 의 잡 대기 상한(10분) 안에 들어온다.
# SHUTDOWN_GRACE 는 +10s 연동.
JOB_TIMEOUT_SECONDS=300
SHUTDOWN_GRACE_SECONDS=310

# ── (6) LangSmith (런타임 트레이스 / 그래프 view) ─────────────────
# Tracing=true 일 때 LangGraph invoke가 자동으로 smith.langchain.com에 전송됨
# LANGSMITH_* 는 AgentSettings 필드가 아니라 langsmith SDK 가 환경변수로 직접
# 소비한다(extra=ignore 로 Settings 는 무시).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=map-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
