# map-service-agent — .env 템플릿
# 실제 값은 `.env`에 채우고 절대 commit 하지 않는다.
# 단일 docker-compose 운영 시 ../map-service-infra/.env.example과 동기화 유지.

# ── (1) PostgreSQL (LangGraph 체크포인터, schema=langgraph) ─────────
POSTGRES_DB=map
POSTGRES_USER=map
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
LANGGRAPH_SCHEMA=langgraph

# ── (2) Redis (Streams agent:jobs:queued / agent:jobs:done, DB3 token-bucket) ───
# DB0=세션 / DB1=JWT 블랙리스트 / DB2=편집 세션 / DB3=rate-limit + Mode1 카운터 + Streams / DB4=hub 캐시
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAMS_DB=3
REDIS_STREAM_QUEUED=agent:jobs:queued
REDIS_STREAM_DONE=agent:jobs:done
REDIS_CONSUMER_GROUP=agent-worker

# ── (3) 내부 서비스 인증·라우팅 (B2 / B4 boundary) ─────────────────
INTERNAL_SERVICE_TOKEN=replace-with-32-chars-or-more
HUB_BASE_URL=http://hub:8000
HUB_TIMEOUT_SECONDS=2

# ── (4) Gemini (LLM, llm_reason 노드 전용, ≤3 calls / request) ─────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPD_LIMIT=250
GEMINI_RPM_LIMIT=10
GEMINI_MAX_CALLS_PER_REQUEST=3

# ── (5) LangSmith (런타임 트레이스 / 그래프 view) ─────────────────
# Tracing=true 일 때 LangGraph invoke가 자동으로 smith.langchain.com에 전송됨
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=map-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
